{
  "$schema": "https://raw.githubusercontent.com/Exit-9B/MCM-Helper/main/docs/config.schema.json",
  "modName": "ModernCameraCollision",
  "displayName": "Modern Camera Collision",
  "minMcmVersion": 13,
  "pluginRequirements": [
    "ModernCameraCollision.esp"
  ],
  "content": [
    {
      "type": "header",
      "text": "Modern Camera Collision"
    },
    {
      "type": "toggle",
      "text": "Enabled",
      "id": "bEnabled:General",
      "help": "The third-person camera sees around small things, eases in and out, and fades what it is let through.",
      "valueOptions": {
        "sourceType": "ModSettingBool"
      }
    },
    {
      "type": "text",
      "text": "Changes apply when this menu closes."
    }
  ],
  "pages": [
    {
      "pageDisplayName": "Motion",
      "content": [
        {
          "type": "header",
          "text": "The distance, in and out"
        },
        {
          "type": "slider",
          "text": "Hold after the way clears (s)",
          "id": "fHoldSecs:Motion",
          "help": "The pulled-in distance is kept this long after the obstacle is gone, so passing a row of posts does not bounce the camera in and out.",
          "valueOptions": {
            "sourceType": "ModSettingFloat",
            "min": 0.0,
            "max": 1.0,
            "step": 0.05,
            "formatString": "{2}"
          }
        },
        {
          "type": "slider",
          "text": "Ease in (s)",
          "id": "fEaseInSecs:Motion",
          "help": "Time constant of the way in. Keep it small: the engine parks the camera a few units short of a surface, and while the way in is still easing the camera is inside it.",
          "valueOptions": {
            "sourceType": "ModSettingFloat",
            "min": 0.005,
            "max": 0.5,
            "step": 0.005,
            "formatString": "{3}"
          }
        },
        {
          "type": "slider",
          "text": "Ease out (s)",
          "id": "fEaseOutSecs:Motion",
          "help": "Time constant of the way back out, after the hold.",
          "valueOptions": {
            "sourceType": "ModSettingFloat",
            "min": 0.01,
            "max": 1.0,
            "step": 0.01,
            "formatString": "{2}"
          }
        }
      ]
    },
    {
      "pageDisplayName": "Rules",
      "content": [
        {
          "type": "header",
          "text": "What stops the camera"
        },
        {
          "type": "text",
          "text": "An occluder stops the camera when it blocks enough of the camera's view of the player AND the shape under the hit is not small."
        },
        {
          "type": "slider",
          "text": "Small: bound radius under",
          "id": "fMinBound:Rules",
          "help": "The trishape under the hit is small when its bounding sphere's radius is under this. Small is faded and never collides. A pot is about 20, a campfire 60-100, a kit wall or floor 190-220.",
          "valueOptions": {
            "sourceType": "ModSettingFloat",
            "min": 5,
            "max": 600,
            "step": 5,
            "formatString": "{0}"
          }
        },
        {
          "type": "header",
          "text": "The body, as the camera sees it"
        },
        {
          "type": "text",
          "text": "The bumper: a stadium of the set width and heights standing upright about the pivot, turned to face the camera about the vertical only. Samples on its edge, a few inside, and a horizontal side line. From a high angle it becomes a level disc at the middle, with points round it, a few inside, and a cross of side points."
        },
        {
          "type": "slider",
          "text": "Half-width (shoulders)",
          "id": "fBodyHalfWidth:Rules",
          "valueOptions": {
            "sourceType": "ModSettingFloat",
            "min": 5,
            "max": 120,
            "step": 1,
            "formatString": "{0}"
          }
        },
        {
          "type": "slider",
          "text": "Above the pivot (head)",
          "id": "fBodyAbove:Rules",
          "valueOptions": {
            "sourceType": "ModSettingFloat",
            "min": 0,
            "max": 150,
            "step": 5,
            "formatString": "{0}"
          }
        },
        {
          "type": "slider",
          "text": "Below the pivot (legs)",
          "id": "fBodyBelow:Rules",
          "valueOptions": {
            "sourceType": "ModSettingFloat",
            "min": 0,
            "max": 200,
            "step": 5,
            "formatString": "{0}"
          }
        },
        {
          "type": "slider",
          "text": "Grid columns inside the bumper",
          "id": "iBodyColumns:Rules",
          "help": "The few points inside the bumper, besides the 16 on its edge.",
          "valueOptions": {
            "sourceType": "ModSettingInt",
            "min": 3,
            "max": 7,
            "step": 1,
            "formatString": "{0}"
          }
        },
        {
          "type": "slider",
          "text": "Grid rows inside the bumper",
          "id": "iBodyRows:Rules",
          "valueOptions": {
            "sourceType": "ModSettingInt",
            "min": 3,
            "max": 9,
            "step": 1,
            "formatString": "{0}"
          }
        },
        {
          "type": "slider",
          "text": "Side line: reach past the body's edge",
          "id": "fSideReach:Rules",
          "help": "A horizontal line of samples at the pivot's height, across the camera's line, reaching this far past the body on both sides: what is beside the player. A pole covers the body and not the sides; a wall covers both.",
          "valueOptions": {
            "sourceType": "ModSettingFloat",
            "min": 0,
            "max": 400,
            "step": 10,
            "formatString": "{0}"
          }
        },
        {
          "type": "slider",
          "text": "Side line: samples per side",
          "id": "iSidePoints:Rules",
          "valueOptions": {
            "sourceType": "ModSettingInt",
            "min": 0,
            "max": 6,
            "step": 1,
            "formatString": "{0}"
          }
        },
        {
          "type": "slider",
          "text": "High angle: from this pitch, a level disc instead",
          "id": "fHighAngle:Rules",
          "help": "With the camera more than this many degrees above or below level, the bumper becomes a level disc at the middle: points round it, a few inside, and the side points as a cross along and across the camera's direction.",
          "valueOptions": {
            "sourceType": "ModSettingFloat",
            "min": 10,
            "max": 85,
            "step": 5,
            "formatString": "{0}"
          }
        },
        {
          "type": "slider",
          "text": "High angle: the disc's radius, as a share of the half-width",
          "id": "fHighScale:Rules",
          "valueOptions": {
            "sourceType": "ModSettingFloat",
            "min": 0.2,
            "max": 1.0,
            "step": 0.05,
            "formatString": "{2}"
          }
        },
        {
          "type": "slider",
          "text": "Dropped when the occluder takes less than",
          "id": "iDropBelowPercent:Rules",
          "help": "Percent of the disc's samples. Once dropped, an occluder needs this plus 12 points to be kept again; once kept, 25 under it to be dropped.",
          "valueOptions": {
            "sourceType": "ModSettingInt",
            "min": 0,
            "max": 100,
            "step": 5,
            "formatString": "{0}%"
          }
        },
        {
          "type": "slider",
          "text": "Same part: hits count within this distance of the sweep's hit",
          "id": "fPartDistance:Rules",
          "help": "A house is one object; its pillar and its wall are told apart by where the rays hit it. Only hits within this distance of the point the camera is about to hit count for that object.",
          "valueOptions": {
            "sourceType": "ModSettingFloat",
            "min": 10,
            "max": 400,
            "step": 10,
            "formatString": "{0}"
          }
        }
      ]
    },
    {
      "pageDisplayName": "Whiskers",
      "content": [
        {
          "type": "header",
          "text": "Seeing walls coming"
        },
        {
          "type": "toggle",
          "text": "Whiskers",
          "id": "bWhiskers:Whiskers",
          "help": "Rays from the player to where the camera would be a little to either side, above and below. A blocked one says a wall is coming before the camera meets it.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "type": "toggle",
          "text": "Vertical whiskers",
          "id": "bVertical:Whiskers",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "type": "toggle",
          "text": "Diagonal whiskers",
          "id": "bDiagonal:Whiskers",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "type": "toggle",
          "text": "Shorten the distance to what the near whiskers measure free",
          "id": "bShorten:Whiskers",
          "help": "The whiskers nearest the camera's line cap the distance, so the camera is already coming in as a wall approaches from behind.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "type": "header",
          "text": "Swing (experimental)"
        },
        {
          "type": "toggle",
          "text": "Swing away from a blocked side",
          "id": "bSwing:Whiskers",
          "help": "Turns the camera's free rotation away from the side a whisker finds blocked. Off by default: it does not yet consider where the player is heading.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "type": "slider",
          "text": "Yaw swing (deg/s at fully blocked)",
          "id": "fSwingYawDegPerSec:Whiskers",
          "valueOptions": {
            "sourceType": "ModSettingFloat",
            "min": 0,
            "max": 180,
            "step": 5,
            "formatString": "{0}"
          }
        },
        {
          "type": "slider",
          "text": "Pitch swing (deg/s at fully blocked)",
          "id": "fSwingPitchDegPerSec:Whiskers",
          "valueOptions": {
            "sourceType": "ModSettingFloat",
            "min": 0,
            "max": 180,
            "step": 5,
            "formatString": "{0}"
          }
        },
        {
          "type": "toggle",
          "text": "Swing yaw the other way",
          "id": "bSwingYawInverted:Whiskers",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "type": "toggle",
          "text": "Swing pitch the other way",
          "id": "bSwingPitchInverted:Whiskers",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "type": "toggle",
          "text": "The player wins: no swing while turning the camera",
          "id": "bIntentWins:Whiskers",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        }
      ]
    },
    {
      "pageDisplayName": "Fade",
      "content": [
        {
          "type": "header",
          "text": "What the camera is let through"
        },
        {
          "type": "toggle",
          "text": "Fade it",
          "id": "bFade:Fade",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "type": "slider",
          "text": "Faded to",
          "id": "fAlpha:Fade",
          "valueOptions": {
            "sourceType": "ModSettingFloat",
            "min": 0.0,
            "max": 1.0,
            "step": 0.05,
            "formatString": "{2}"
          }
        },
        {
          "type": "slider",
          "text": "Over (s)",
          "id": "fSecs:Fade",
          "valueOptions": {
            "sourceType": "ModSettingFloat",
            "min": 0.0,
            "max": 1.0,
            "step": 0.05,
            "formatString": "{2}"
          }
        },
        {
          "type": "toggle",
          "text": "Fade shapes that carry their own alpha",
          "id": "bFadeOwnAlpha:Fade",
          "help": "A window's frame, leaves, a grate. Their shadow pass multiplies the texture's alpha by the fade, so their shadow goes with it -- a window's light shaft most visibly.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "type": "toggle",
          "text": "Faded shapes keep casting shadows",
          "id": "bKeepShadows:Fade",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        }
      ]
    },
    {
      "pageDisplayName": "Layers",
      "content": [
        {
          "type": "header",
          "text": "A rule per collision layer"
        },
        {
          "type": "text",
          "text": "Measure: the disc and the size decide. Stop: always stops the camera. Through: never stops it, faded whole."
        },
        {
          "type": "enum",
          "text": "L_STATIC",
          "id": "iL_STATIC:Layers",
          "valueOptions": {
            "sourceType": "ModSettingInt",
            "options": [
              "Measure",
              "Stop",
              "Through"
            ],
            "shortNames": [
              "Measure",
              "Stop",
              "Through"
            ]
          }
        },
        {
          "type": "enum",
          "text": "L_ANIMSTATIC",
          "id": "iL_ANIMSTATIC:Layers",
          "help": "Doors and gates are here, with levers and the like.",
          "valueOptions": {
            "sourceType": "ModSettingInt",
            "options": [
              "Measure",
              "Stop",
              "Through"
            ],
            "shortNames": [
              "Measure",
              "Stop",
              "Through"
            ]
          }
        },
        {
          "type": "enum",
          "text": "L_TREES",
          "id": "iL_TREES:Layers",
          "valueOptions": {
            "sourceType": "ModSettingInt",
            "options": [
              "Measure",
              "Stop",
              "Through"
            ],
            "shortNames": [
              "Measure",
              "Stop",
              "Through"
            ]
          }
        },
        {
          "type": "enum",
          "text": "L_TERRAIN",
          "id": "iL_TERRAIN:Layers",
          "valueOptions": {
            "sourceType": "ModSettingInt",
            "options": [
              "Measure",
              "Stop",
              "Through"
            ],
            "shortNames": [
              "Measure",
              "Stop",
              "Through"
            ]
          }
        },
        {
          "type": "enum",
          "text": "L_GROUND",
          "id": "iL_GROUND:Layers",
          "valueOptions": {
            "sourceType": "ModSettingInt",
            "options": [
              "Measure",
              "Stop",
              "Through"
            ],
            "shortNames": [
              "Measure",
              "Stop",
              "Through"
            ]
          }
        }
      ]
    },
    {
      "pageDisplayName": "Debug",
      "content": [
        {
          "type": "header",
          "text": "Drawn over the game"
        },
        {
          "type": "toggle",
          "text": "Draw the discs",
          "id": "bDrawDiscs:Debug",
          "help": "The bumper (or the high-angle disc) at each judgement: yellow kept, orange dropped; blue when measured for a whisker; a mark where each sample found the occluder.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "type": "toggle",
          "text": "Draw the whiskers",
          "id": "bDrawWhiskers:Debug",
          "help": "Red where a whisker found something the camera would stop at, green where clear or let through.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "type": "toggle",
          "text": "Draw the rays",
          "id": "bDrawRays:Debug",
          "help": "The engine's own sweep in white, ending where the camera was put, and every disc sample's ray from the player.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "type": "toggle",
          "text": "Draw the faded shapes' bounds",
          "id": "bDrawBounds:Debug",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "type": "header",
          "text": "Log"
        },
        {
          "type": "toggle",
          "text": "Verbose log",
          "id": "bLogVerbose:Debug",
          "help": "The first ten camera updates and then one in sixty, hit by hit, in Documents/My Games/Skyrim Special Edition/SKSE/ModernCameraCollision.log.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        }
      ]
    }
  ]
}